/**
 * AuraEnabled controller that invokes the Knowledge_Answers_based_on_health_pdf
 * GenAI prompt template and returns only the generated text portion of the response.
 */
public with sharing class HealthQueryController {

    private static final String TEMPLATE_API_NAME = 'Knowledge_Answers_based_on_health_pdf';
    private static final String RETRIEVER_ID      = '1Cxak000000L4a5CAC';

    /**
     * Wrapper returned to the LWC.
     */
    public class HealthQueryResult {
        /** The plain-text answer generated by the prompt template. */
        @AuraEnabled public String text;
    }

    /**
     * Calls the health-PDF prompt template and returns the generated answer text.
     *
     * @param query The user's natural-language question.
     * @return HealthQueryResult containing the answer text.
     */
    @AuraEnabled
    public static HealthQueryResult askHealthQuestion(String query) {
        if (String.isBlank(query)) {
            throw new AuraHandledException('Please enter a question before submitting.');
        }

        try {
            // Build the prompt template input
            ConnectApi.EinsteinPromptTemplateGenerationsInput promptInput =
                new ConnectApi.EinsteinPromptTemplateGenerationsInput();
            promptInput.isPreview   = false;
            promptInput.inputParams = new Map<String, ConnectApi.WrappedValue>();

            ConnectApi.WrappedValue queryValue = new ConnectApi.WrappedValue();
            queryValue.value = query;
            promptInput.inputParams.put('Input:Query', queryValue);

            ConnectApi.WrappedValue retrieverValue = new ConnectApi.WrappedValue();
            retrieverValue.value = RETRIEVER_ID;
            promptInput.inputParams.put('Input:RetrieverIdOrName', retrieverValue);

            // Invoke the prompt template
            ConnectApi.EinsteinPromptTemplateGenerationsRepresentation result =
                ConnectApi.EinsteinLLM.generateMessagesForPromptTemplate(
                    TEMPLATE_API_NAME,
                    promptInput
                );

            // Serialize to JSON and navigate to the first generation's text
            // (avoids needing to reference internal ConnectApi subtype names)
            Map<String, Object> resultMap  = (Map<String, Object>) JSON.deserializeUntyped(JSON.serialize(result));
            List<Object>        generations = (List<Object>) resultMap.get('generations');
            Map<String, Object> firstGen   = (Map<String, Object>) generations[0];
            String rawText = (String) firstGen.get('text');
            return parseGeneratedText(rawText);

        } catch (AuraHandledException ahe) {
            throw ahe;
        } catch (Exception e) {
            throw new AuraHandledException('Unable to get an answer: ' + e.getMessage());
        }
    }

    /**
     * Parses the JSON envelope returned by the prompt template and extracts the text field.
     * Expected shape: {"response":{"text":"...","source":[...]}}
     *
     * @param rawText The raw JSON string from the LLM generation result.
     * @return HealthQueryResult with the text field populated.
     */
    @TestVisible
    private static HealthQueryResult parseGeneratedText(String rawText) {
        HealthQueryResult queryResult = new HealthQueryResult();
        try {
            Map<String, Object> outerMap    = (Map<String, Object>) JSON.deserializeUntyped(rawText);
            Map<String, Object> responseMap = (Map<String, Object>) outerMap.get('response');
            queryResult.text = (String) responseMap?.get('text');
        } catch (Exception e) {
            // If the template returns plain text instead of JSON, use it as-is
            queryResult.text = rawText;
        }
        return queryResult;
    }
}