<apex:page controller="ApexLabsRegistrationController" 
           showHeader="false" 
           sidebar="false" 
           standardStylesheets="false" 
           applyBodyTag="false" 
           applyHtmlTag="false">

<html lang="en">

<head>

    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

    <title>Apex Labs Registration</title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
                         Roboto, Helvetica, Arial, sans-serif;

            background: linear-gradient(135deg, #eef7ff, #f7fbff, #eefaf3);

            min-height: 100vh;

            display: flex;
            align-items: center;
            justify-content: center;

            padding: 30px 15px;

            color: #1f2937;
        }

        .form-wrapper {
            width: 100%;
            max-width: 650px;
        }

        .form-card {
            background: #ffffff;

            border-radius: 20px;

            padding: 40px;

            box-shadow: 0 15px 45px rgba(31, 41, 55, 0.12);

            border: 1px solid rgba(226, 232, 240, 0.8);
        }

        .form-header {
            text-align: center;
            margin-bottom: 32px;
        }

        .form-icon {
            width: 58px;
            height: 58px;

            margin: 0 auto 16px;

            border-radius: 16px;

            background: linear-gradient(135deg, #2563eb, #14b8a6);

            display: flex;
            align-items: center;
            justify-content: center;

            color: white;

            font-size: 27px;

            box-shadow: 0 8px 20px rgba(37, 99, 235, 0.22);
        }

        .form-header h1 {
            margin: 0 0 10px;

            font-size: 28px;

            font-weight: 700;

            color: #111827;
        }

        .form-header p {
            margin: 0;

            font-size: 15px;

            line-height: 1.6;

            color: #6b7280;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-row {
            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 18px;
        }

        label {
            display: block;

            margin-bottom: 8px;

            font-size: 14px;

            font-weight: 600;

            color: #374151;
        }

        .required {
            color: #ef4444;

            margin-left: 3px;
        }

        input[type="text"],
        input[type="email"],
        select,
        textarea {

            width: 100%;

            border: 1px solid #dbe2ea;

            border-radius: 10px;

            padding: 13px 15px;

            font-size: 15px;

            font-family: inherit;

            color: #111827;

            background: #fbfdff;

            outline: none;

            transition: all 0.2s ease;
        }

        input[type="text"],
        input[type="email"],
        select {

            height: 48px;
        }

        textarea {

            min-height: 110px;

            resize: vertical;
        }

        input[type="text"]:focus,
        input[type="email"]:focus,
        select:focus,
        textarea:focus {

            border-color: #3b82f6;

            background: #ffffff;

            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.10);
        }

        input::placeholder,
        textarea::placeholder {

            color: #9ca3af;
        }

        .submit-wrapper {

            margin-top: 28px;
        }

        .submit-button {

            width: 100%;

            height: 52px;

            border: none;

            border-radius: 11px;

            background: linear-gradient(135deg, #2563eb, #14b8a6);

            color: white;

            font-size: 16px;

            font-weight: 700;

            font-family: inherit;

            cursor: pointer;

            transition: all 0.2s ease;

            box-shadow: 0 8px 18px rgba(37, 99, 235, 0.20);
        }

        .submit-button:hover {

            transform: translateY(-1px);

            box-shadow: 0 11px 24px rgba(37, 99, 235, 0.27);
        }

        .submit-button:active {

            transform: translateY(0);
        }

        .form-footer {

            text-align: center;

            margin-top: 20px;

            font-size: 12px;

            color: #9ca3af;
        }

        .message {

            padding: 12px;

            margin-bottom: 20px;

            border-radius: 10px;

            text-align: center;

            font-size: 14px;

            color: #065f46;

            background: #ecfdf5;

            border: 1px solid #a7f3d0;
        }

        @media (max-width: 600px) {

            body {

                padding: 15px;
            }

            .form-card {

                padding: 28px 22px;

                border-radius: 16px;
            }

            .form-header h1 {

                font-size: 24px;
            }

            .form-row {

                grid-template-columns: 1fr;

                gap: 0;
            }
        }

    </style>

</head>

<body>

<div class="form-wrapper">

    <div class="form-card">

        <div class="form-header">

            <div class="form-icon">✓</div>

            <h1>Get Started</h1>

            <p>
                Please fill in your details below.
                We'll use this information to get in touch with you.
            </p>

        </div>


        <!-- Messages -->

        <apex:pageMessages />


        <apex:form >

            <!-- First Name / Last Name -->

            <div class="form-row">

                <div class="form-group">

                    <label>
                        First Name
                    </label>

                    <apex:inputText value="{!firstName}"
                        maxlength="40"
                        html-placeholder="Enter your first name"/>

                </div>


                <div class="form-group">

                    <label>
                        Last Name
                        <span class="required">*</span>
                    </label>

                    <apex:inputText value="{!lastName}"
                        maxlength="80"
                        html-placeholder="Enter your last name"/>

                </div>

            </div>


            <!-- Phone -->

            <div class="form-group">

                <label>
                    Phone
                </label>

                <apex:inputText value="{!phone}"
                    maxlength="40"
                    html-placeholder="Enter your phone number"/>

            </div>


            <!-- Email -->

            <div class="form-group">

                <label>
                    Email
                    <span class="required">*</span>
                </label>

                <apex:inputText value="{!email}"
                    maxlength="80"
                    html-placeholder="Enter your email address"/>

            </div>


            <!-- College -->

            <div class="form-group">

                <label>
                    College
                </label>

                <apex:inputText value="{!college}"
                    maxlength="255"
                    html-placeholder="Enter your college name"/>

            </div>


            <!-- Highest Education Qualification -->

            <div class="form-group">

                <label>
                    Highest Education Qualification
                </label>

                <apex:selectList value="{!highestEducationQualification}"
                    size="1">

                    <apex:selectOptions value="{!educationOptions}"/>

                </apex:selectList>

            </div>


            <!-- Company -->

            <div class="form-group">

                <label>
                    Company
                </label>

                <apex:inputText value="{!company}"
                    maxlength="40"
                    html-placeholder="Enter your company name"/>

            </div>


            <!-- Address -->

            <div class="form-group">

                <label>
                    Address
                </label>

                <apex:inputTextarea value="{!address}"
                    html-placeholder="Enter your address"/>

            </div>


            <!-- Submit -->

            <div class="submit-wrapper">

                <apex:commandButton value="Submit Response"
                    action="{!submitRegistration}"
                    styleClass="submit-button"/>

            </div>


            <div class="form-footer">

                Your information is submitted securely.

            </div>

        </apex:form>

    </div>

</div>

</body>

</html>

</apex:page>